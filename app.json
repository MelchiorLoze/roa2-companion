{
  "expo": {
    "name": "Rivals of Aether II Companion",
    "slug": "roa2-companion",
    "version": "2.5.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "roa2-companion",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0825",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cp0-mand4le.roa2companion"
    },
    "android": {
      "versionCode": 20,
      "package": "com.cp0_mand4le.roa2companion",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0825"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/icon.png"
    },
    "plugins": [
      "expo-image",
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usePrecompiledHeaders": true
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "light",
          "hidden": false,
          "enforceContrast": false
        }
      ],
      [
        "expo-font",
        {
          "fonts": ["./src/assets/fonts"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/icon.png",
          "imageWidth": 200,
          "backgroundColor": "#0B0825"
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "light",
          "hidden": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
