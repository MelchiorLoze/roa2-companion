{
  "version": "2.5.0",
  "name": "roa2-companion",
  "private": true,
  "author": {
    "name": "Melchior Lozé",
    "email": "melchior.loze@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MelchiorLoze/roa2-companion"
  },
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "reset": "expo prebuild",
    "test": "jest --randomize",
    "test:dev": "jest --randomize --watchAll",
    "test:update-snapshots": "jest --updateSnapshot",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --randomize",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "lint:ci": "expo lint --max-warnings 0",
    "type-check": "tsc --strict --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@shopify/react-native-skia)/"
    ],
    "testEnvironment": "@shopify/react-native-skia/jestEnv.js",
    "setupFiles": [
      "react-native-unistyles/mocks",
      "<rootDir>/src/unistyles.ts"
    ],
    "setupFilesAfterEnv": [
      "@shopify/react-native-skia/jestSetup.js",
      "<rootDir>/src/jest.setup.ts",
      "<rootDir>/src/jest.mock.ts"
    ],
    "clearMocks": true
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.101.4",
    "country-flag-icons": "^1.6.20",
    "expo": "^57.0.10",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "fast-xml-builder": "^1.3.0",
    "fast-xml-parser": "^5.10.1",
    "luxon": "^3.7.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gifted-charts": "^1.4.77",
    "react-native-nitro-modules": "0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-unistyles": "^3.3.0",
    "react-native-worklets": "0.10.1",
    "type-fest": "^5.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@leancodepl/resolve-eslint-flat-config": "^10.6.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/eslint-config": "^0.86.2",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/country-flag-icons": "^1.2.2",
    "@types/jest": "29.5.14",
    "@types/luxon": "^3.7.3",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-native-unistyles": "^3.0.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "expo-dev-client": "~57.0.10",
    "fetch-mock": "^12.6.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "jest-fail-on-console": "^3.3.4",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "eslint-plugin-ft-flow": "^3.0.11",
    "zod-validation-error": "^4.0.2"
  }
}
